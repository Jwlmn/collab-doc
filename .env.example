# 复制为 .env 使用：cp .env.example .env

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=collab_doc
DB_USERNAME=collab
DB_PASSWORD=secret

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# HocusPocus 协作服务器
COLLAB_PORT=1234
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,::1,localhost:8000

# 协作服务器共享密钥（Laravel 与 HocusPocus 校验协作令牌）
COLLAB_SECRET=collab-doc-dev-secret

# 生产编排（docker-compose.prod.yml 变量替换；.env 不入库）
# 生成：php artisan key:generate --show   /   openssl rand -hex 32
APP_KEY=
# COLLAB_SECRET 已在上方
